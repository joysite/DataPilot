# ==========================================
# DataPilot Docker 环境配置
# 复制为 .env 后按实际环境调整
# ==========================================

# 前端访问端口，仅绑定宿主机 localhost
DATAPILOT_WEB_PORT=8088

# 后端业务数据库与 Agent Checkpointer
# 两个 SQLite 文件位于同一个持久化数据卷
DATAPILOT_DATABASE_URL=sqlite+aiosqlite:////app/data/datapilot.db
DATAPILOT_CHECKPOINTER_PATH=/app/data/checkpointer.db

# Ollama 宿主机服务
# 注意：宿主机 Ollama 需要允许 Docker 容器访问
DATAPILOT_OLLAMA_BASE_URL=http://host.docker.internal:11434
DATAPILOT_OLLAMA_MODEL=qwen2.5-coder:7b
DATAPILOT_OLLAMA_TEMPERATURE=0.0
